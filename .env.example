# QxBroker Candle Data API - Environment Configuration
# Copy this file to .env and fill in your credentials

# QxBroker Account Credentials (REQUIRED)
QX_EMAIL=your_email@example.com
QX_PASSWORD=your_password

# Account Type: PRACTICE or REAL (default: PRACTICE)
QX_ACCOUNT=PRACTICE

# API Server Configuration
API_HOST=0.0.0.0
API_PORT=8000
